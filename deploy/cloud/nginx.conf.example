# Replace PUBLIC_IP and certificate paths after a staging ACME check.
server {
    listen 80;
    server_name PUBLIC_IP;
    location /.well-known/acme-challenge/ { root /var/www/ournotes-acme; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    # Authentication headers, aliases and codes never go to access logs.
    access_log off;
    location = /api/cloud/v1/events {
        proxy_pass http://127.0.0.1:8770;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 75s;
        add_header Cache-Control "no-store" always;
    }
    location /api/cloud/v1/ {
        proxy_pass http://127.0.0.1:8770;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 45s;
        add_header Cache-Control "no-store" always;
    }
    location / {
        proxy_pass http://127.0.0.1:8770;
        proxy_set_header Host $host;
    }
}
